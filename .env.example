# Copy to .env and change every secret before exposing the stack anywhere.

# PostgreSQL owner (used only by the migrator)
POSTGRES_USER=stockforge
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=stockforge

# Least-privileged runtime role used by API and worker (row-level security applies to it)
APP_DB_PASSWORD=change-me-app

# HMAC-SHA256 key for access tokens: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-bytes

# Platform super-administrator created on first start
SUPERADMIN_EMAIL=superadmin@stockforge.local
SUPERADMIN_PASSWORD=SuperAdmin!2026

# Demo organizations, users and 30 days of history (set false for real deployments)
SEED_DEMO_DATA=true
DEMO_PASSWORD=StockForge!2026

# Public URLs (browser-facing)
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
OPENAPI_ENABLED=true

# SMTP (defaults to the bundled Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@stockforge.local

ASPNETCORE_ENVIRONMENT=Production
