<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- CA1848/CA1873 (LoggerMessage delegates) and CA2007 (ConfigureAwait) add noise in an ASP.NET Core app.
         CA1862/CA1826/CA1859 misfire on EF Core LINQ expressions that are translated to SQL. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1862;CA1826;CA1859;CA1716;CA1711;CA1062;CA1515;CA1031;CA2227;CA1002;CA1819;CA1308;CA1305;CA1304;CA1311;CA1863;CA1056;CA1054;CA1055;CA2234;CA1724;CA1034;CA5394;CA1307;CA1310;CA1861;CA1812</NoWarn>
  </PropertyGroup>
</Project>
