{
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@stockforge.local",
    "FromName": "StockForge"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollInterval": "00:00:02",
    "LockDuration": "00:05:00"
  },
  "Scheduler": {
    "DailySummaryHourUtc": 6,
    "Tick": "00:01:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  }
}
