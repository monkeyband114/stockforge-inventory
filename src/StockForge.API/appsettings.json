{
  "ConnectionStrings": {
    "Default": "",
    "Migrations": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "stockforge",
    "Audience": "stockforge-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "RefreshReuseGraceSeconds": 15
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Seed": {
    "DemoData": false
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@stockforge.local",
    "FromName": "StockForge"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "RefreshPermitsPerMinute": 60,
    "GlobalPermitsPerMinute": 600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*"
}
